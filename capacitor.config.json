{
  "appId": "com.sauda.app",
  "appName": "Sauda",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#FEFBF4",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "Light",
      "backgroundColor": "#FEFBF4"
    }
  },
  "android": {
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
